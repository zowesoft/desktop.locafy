{
  "recipes": [
    {
      "id": "laravel",
      "label": "Laravel",
      "language": "PHP",
      "framework": "Laravel",
      "description": "PHP framework with Artisan, migrations, queues and Blade views.",
      "docs": "https://laravel.com/docs/13.x/installation",
      "verifiedAt": "Laravel 13.11.0 and installer 5.25.3, checked 2026-11-17",
      "options": [
        {
          "key": "version",
          "label": "Laravel version",
          "default": "13",
          "values": [
            { "value": "13", "label": "13 (latest, PHP 8.3+)" },
            { "value": "12", "label": "12 (security fixes until Feb 2027)" }
          ]
        },
        {
          "key": "starterKit",
          "label": "Starter kit",
          "default": "none",
          "values": [
            { "value": "none", "label": "None (plain Laravel)" },
            { "value": "react", "label": "React" },
            { "value": "vue", "label": "Vue" },
            { "value": "livewire", "label": "Livewire" }
          ]
        },
        {
          "key": "database",
          "label": "Database",
          "default": "sqlite",
          "values": [
            { "value": "sqlite", "label": "SQLite (no server needed)" },
            { "value": "mysql", "label": "MySQL" },
            { "value": "pgsql", "label": "PostgreSQL" }
          ]
        }
      ],
      "requires": [
        { "tool": "php", "label": "PHP", "minVersion": "8.3" },
        { "tool": "composer", "label": "Composer", "minVersion": "2.2" }
      ],
      "commands": [
        {
          "bin": "laravel",
          "cwd": "parent",
          "when": "tool:laravel && option:version=13",
          "args": [
            "new",
            "{dir}",
            "--no-interaction",
            "--database={database}",
            { "when": "option:starterKit=react", "args": ["--react"] },
            { "when": "option:starterKit=vue", "args": ["--vue"] },
            { "when": "option:starterKit=livewire", "args": ["--livewire"] }
          ]
        },
        {
          "bin": "composer",
          "cwd": "parent",
          "when": "tool:missing:laravel || option:version=12",
          "args": [
            "create-project",
            "laravel/laravel:^{version}.0",
            "{dir}",
            "--no-interaction",
            "--prefer-dist"
          ]
        }
      ],
      "verify": ["artisan", "composer.json"],
      "application": { "startCommand": "php artisan serve" }
    },
    {
      "id": "nextjs",
      "label": "Next.js",
      "language": "TypeScript",
      "framework": "Next.js",
      "description": "React framework with the App Router, server components and Turbopack.",
      "docs": "https://nextjs.org/docs/app/getting-started/installation",
      "verifiedAt": "create-next-app 16.4.6, checked 2026-11-17",
      "options": [
        {
          "key": "version",
          "label": "Next.js version",
          "default": "16",
          "values": [
            { "value": "16", "label": "16 (latest)" },
            { "value": "15", "label": "15 (maintenance)" }
          ]
        }
      ],
      "requires": [
        { "tool": "node", "label": "Node.js", "minVersion": "20.19" },
        { "tool": "npm", "label": "npm", "minVersion": "10" }
      ],
      "commands": [
        {
          "bin": "npx",
          "cwd": "parent",
          "args": [
            "--yes",
            "create-next-app@{version}",
            "{dir}",
            "--ts",
            "--eslint",
            "--app",
            "--src-dir",
            "--import-alias",
            "@/*",
            "--use-npm",
            "--yes"
          ]
        }
      ],
      "verify": ["package.json", "src/app"],
      "application": { "startCommand": "npm run dev" }
    },
    {
      "id": "vite",
      "label": "Vite",
      "language": "TypeScript",
      "framework": "Vite",
      "description": "Front-end dev server and build tool with a React or Vue template.",
      "docs": "https://vite.dev/guide/",
      "verifiedAt": "create-vite 9.3.4 (Vite 8.3.8) and 8.3.0 (Vite 7.3), checked 2026-11-17",
      "options": [
        {
          "key": "createVite",
          "label": "Vite version",
          "default": "9",
          "values": [
            { "value": "9", "label": "Vite 8 (latest)" },
            { "value": "8", "label": "Vite 7" }
          ]
        },
        {
          "key": "template",
          "label": "Template",
          "default": "react-ts",
          "values": [
            { "value": "react-ts", "label": "React + TypeScript" },
            { "value": "vue-ts", "label": "Vue + TypeScript" }
          ]
        }
      ],
      "requires": [
        { "tool": "node", "label": "Node.js", "minVersion": "20.19" },
        { "tool": "npm", "label": "npm", "minVersion": "10" }
      ],
      "commands": [
        {
          "bin": "npx",
          "cwd": "parent",
          "args": ["--yes", "create-vite@{createVite}", "{dir}", "--template", "{template}"]
        },
        { "bin": "npm", "cwd": "inside", "args": ["install"] }
      ],
      "verify": ["package.json", "index.html"],
      "application": { "startCommand": "npm run dev" }
    },
    {
      "id": "django",
      "label": "Django",
      "language": "Python",
      "framework": "Django",
      "description": "Python web framework with an admin, ORM and migrations, in its own virtual environment.",
      "docs": "https://docs.djangoproject.com/en/6.1/intro/install/",
      "verifiedAt": "Django 6.1.3 and 5.2 LTS, checked 2026-11-17",
      "options": [
        {
          "key": "version",
          "label": "Django version",
          "default": "6.1",
          "values": [
            { "value": "6.1", "label": "6.1 (latest, Python 3.12+)" },
            { "value": "5.2", "label": "5.2 LTS (Python 3.10+)" }
          ]
        }
      ],
      "requires": [
        { "tool": "python", "label": "Python", "minVersion": "3.10" }
      ],
      "commands": [
        { "bin": "{python}", "cwd": "inside", "args": ["-m", "venv", ".venv"] },
        {
          "bin": "{venv_python}",
          "cwd": "inside",
          "args": ["-m", "pip", "install", "django~={version}.0"]
        },
        {
          "bin": "{venv_python}",
          "cwd": "inside",
          "args": ["-m", "django", "startproject", "config", "."]
        }
      ],
      "verify": ["manage.py", ".venv"],
      "application": { "startCommand": ".venv\\Scripts\\python manage.py runserver" }
    },
    {
      "id": "dotnet",
      "label": ".NET",
      "language": "C#",
      "framework": "ASP.NET Core",
      "description": "Minimal ASP.NET Core web API on the selected .NET SDK.",
      "docs": "https://learn.microsoft.com/aspnet/core/tutorials/min-web-api",
      "verifiedAt": ".NET 11.0.0 and 10.0.15, checked 2026-11-17",
      "options": [
        {
          "key": "version",
          "label": ".NET version",
          "default": "11.0",
          "values": [
            { "value": "11.0", "label": "11 (latest)" },
            { "value": "10.0", "label": "10 (LTS)" }
          ]
        }
      ],
      "requires": [
        { "tool": "dotnet", "label": ".NET SDK", "minVersion": "10" }
      ],
      "commands": [
        {
          "bin": "dotnet",
          "cwd": "parent",
          "args": [
            "new",
            "webapi",
            "--name",
            "{name}",
            "--output",
            "{dir}",
            "--framework",
            "net{version}",
            "--no-https"
          ]
        }
      ],
      "verify": ["Program.cs"],
      "application": { "startCommand": "dotnet run" }
    }
  ]
}
